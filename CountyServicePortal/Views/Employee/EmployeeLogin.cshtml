@model CountyServicePortal.Models.Employees

<h2>Login to Employee Account</h2>

<form asp-action="EmployeeLogin" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="Username"></label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <br />

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Login
    </button>

    <div>
        <p>New Employee? <a asp-action="CreateEmployee" asp-controller="Employee">Create an account here</a>.</p>
    </div>
</form>
