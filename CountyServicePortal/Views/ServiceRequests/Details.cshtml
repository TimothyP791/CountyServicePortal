@model CountyServicePortal.Models.ServiceRequest

<h2>Service Request Details</h2>

<div class="card">
    <div class="card-body">

        <h4>@Model.Title</h4>

        <p>
            <strong>ID:</strong>
            @Model.RequestId
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Category:</strong>
            @Model.Category
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
            <a asp-action="UpdateStatus" asp-route-id="@Model.RequestId" class="btn btn-primary">
                Update Status
            </a>
        </p>

        <p>
            <strong>Date Submitted:</strong>
            @Model.DateSubmitted
        </p>

    </div>
</div>

