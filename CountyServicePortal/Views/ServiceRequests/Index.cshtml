@model IEnumerable<CountyServicePortal.Models.ServiceRequest>

<h2>Service Requests</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Category</th>
            <th>Status</th>
            <th>Date Submitted</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.RequestId</td>
                <td><a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@request.RequestId">@request.Title</a></td>
                <td>@request.Category</td>
                <td>@request.Status</td>
                <td>@request.DateSubmitted.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
